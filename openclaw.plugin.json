{
  "id": "tts-speaker",
  "name": "TTS Speaker",
  "version": "0.1.0",
  "description": "Local text-to-speech speaker playback",

  "capabilityCatalogEntry": "./dist/openclaw/capability-catalog.js",

  "contracts": {
    "speechProviders": [
      "tts-speaker"
    ]
  },

  "configGroups": [
    {
      "id": "voice",
      "title": "Voice",
      "order": 10,
      "properties": [
        "defaultSpeakerId",
        "fallbackSpeakerId",
        "additionalVoices"
      ]
    },
    {
      "id": "playback",
      "title": "Playback",
      "order": 20,
      "properties": [
        "speedScale"
      ]
    }
  ],

  "uiHints": {
    "defaultSpeakerId": {
      "label": "Default Speaker ID",
      "help": "VOICEVOX style ID used for normal speech."
    },
    "fallbackSpeakerId": {
      "label": "Fallback Speaker ID",
      "help": "VOICEVOX style ID used as the final emergency fallback."
    },
    "additionalVoices": {
      "label": "Additional Voices",
      "help": "Additional VOICEVOX voice definitions available to the model."
    },
    "speedScale": {
      "label": "Speech Speed",
      "help": "VOICEVOX speech speed multiplier."
    }
  },

  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "defaultSpeakerId": {
        "type": "integer",
        "minimum": 0
      },
      "fallbackSpeakerId": {
        "type": "integer",
        "minimum": 0
      },
      "additionalVoices": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0
            },
            "key": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "enum": [
                "normal",
                "emotion",
                "special"
              ]
            }
          },
          "required": [
            "id",
            "key",
            "label",
            "description",
            "kind"
          ]
        }
      },
      "speedScale": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    }
  }
}
